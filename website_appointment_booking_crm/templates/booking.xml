<odoo>
    <template
        id="booking_page_request"
        inherit_id="website_appointment_booking.booking_page"
        name="Out-of-hours request banner"
    >
        <xpath expr="//div[hasclass('o_wab_calendar_row')]" position="before">
            <!-- Success confirmation after a request -->
            <div t-if="request_success" class="row mb-3">
                <div class="col-lg-10 mx-auto">
                    <div
                        class="alert o_wab_success_banner alert-dismissible fade show d-flex align-items-center gap-2"
                        role="alert"
                    >
                        <i class="fa fa-paper-plane text-success" />
                        <span>
                            Request received. We will reply within one business day.
                        </span>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close"
                        />
                    </div>
                </div>
            </div>

            <!-- Banner + form, shown when the visitor's local working hours
                 have no overlap with the published booking calendar -->
            <div t-if="show_request_banner" class="row mb-3">
                <div class="col-lg-10 mx-auto">
                    <div class="o_wab_request_banner p-4">
                        <div class="d-flex align-items-start gap-3">
                            <i class="fa fa-globe o_wab_request_icon" />
                            <div class="flex-grow-1">
                                <p class="mb-1 fw-semibold">
                                    None of these times fit your timezone?
                                </p>
                                <p class="mb-2 text-muted small">
                                    Tell us when you would like to talk. We will
                                    open a slot and reply within one business day.
                                </p>
                                <button
                                    type="button"
                                    class="btn btn-outline-primary btn-sm o_wab_request_toggle"
                                >
                                    <i class="fa fa-envelope me-1" />
                                    Request a custom slot
                                </button>
                            </div>
                        </div>

                        <form
                            id="o_wab_request_form"
                            method="post"
                            t-attf-action="/book/#{booking_type.website_slug}/request"
                            class="o_wab_request_form d-none mt-4"
                        >
                            <t
                                t-call="website_appointment_booking.booking_form_guard"
                            />
                            <input
                                type="hidden"
                                name="visitor_tz"
                                t-att-value="effective_tz"
                            />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label
                                        for="o_wab_request_name"
                                        class="form-label"
                                    >Name *</label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="o_wab_request_name"
                                        name="name"
                                        required="required"
                                        placeholder="Your full name"
                                    />
                                </div>
                                <div class="col-md-6">
                                    <label
                                        for="o_wab_request_email"
                                        class="form-label"
                                    >Email *</label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="o_wab_request_email"
                                        name="email"
                                        required="required"
                                        placeholder="you@example.com"
                                    />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label
                                    for="o_wab_request_window"
                                    class="form-label"
                                >Preferred 2-hour window (in your timezone)</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="o_wab_request_window"
                                    name="preferred_window"
                                    placeholder="e.g. Tue / Thu 09:00-11:00"
                                />
                            </div>
                            <div class="mt-3">
                                <label
                                    for="o_wab_request_note"
                                    class="form-label"
                                >Anything else we should know?</label>
                                <textarea
                                    class="form-control"
                                    id="o_wab_request_note"
                                    name="note"
                                    rows="2"
                                    placeholder="Optional context: what you would like to discuss, project specifics, etc."
                                />
                            </div>
                            <div class="mt-3">
                                <button
                                    type="submit"
                                    class="btn btn-primary o_wab_submit_btn"
                                >
                                    <i class="fa fa-paper-plane me-1" />
                                    Submit Request
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
