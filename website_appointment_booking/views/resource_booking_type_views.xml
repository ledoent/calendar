<odoo>
    <record id="resource_booking_type_view_form_inherit_website" model="ir.ui.view">
        <field name="name">resource.booking.type.form.website</field>
        <field name="model">resource.booking.type</field>
        <field
            name="inherit_id"
            ref="resource_booking.resource_booking_type_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="open_website_url"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-globe"
                    invisible="not website_slug"
                >
                    <div class="o_stat_info o_field_widget">
                        <span class="o_stat_text">Go to Website</span>
                        <span class="o_stat_text text-success" invisible="not website_published">Published</span>
                        <span class="o_stat_text text-danger" invisible="website_published">Unpublished</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="before">
                <field
                    name="website_card_image"
                    widget="image"
                    class="oe_avatar"
                    invisible="not website_published"
                    options="{'preview_image': 'website_card_image'}"
                />
            </xpath>
            <xpath expr="//group[@name='main']" position="after">
                <group name="website" string="Website">
                    <group>
                        <field name="website_published" />
                        <field name="website_slug" invisible="not website_published" />
                        <field name="require_upfront_payment" invisible="not website_published" />
                        <field
                            name="payment_product_id"
                            invisible="not require_upfront_payment"
                            required="require_upfront_payment"
                        />
                        <field
                            name="payment_price"
                            invisible="not require_upfront_payment"
                        />
                        <field
                            name="payment_hold_expiry_hours"
                            invisible="not require_upfront_payment"
                        />
                    </group>
                    <group>
                        <field
                            name="website_description"
                            invisible="not website_published"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
